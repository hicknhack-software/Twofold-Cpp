{
	"name": "twofold",
	"displayName": "Twofold Language Support",
	"description": "Syntax highlighting and formatting for Twofold template language",
	"version": "0.2.7",
	"publisher": "hicknhack-software",
	"engines": {
		"vscode": "^1.85.0"
	},
	"main": "./out/extension.js",
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -p ./ -w",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^3.0.0",
		"typescript": "^5.0.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "twofold",
				"aliases": [
					"Twofold",
					"twofold"
				],
				"extensions": [
					".twofold"
				],
				"filenames": [],
				"configuration": "./language-configuration.json"
			},
			{
				"id": "twofold-cpp",
				"aliases": [
					"Twofold C++",
					"twofold-cpp"
				],
				"extensions": [
					".hpp.twofold",
					".cpp.twofold",
					".h.twofold",
					".c.twofold",
					".hxx.twofold",
					".cxx.twofold",
					".cc.twofold",
					".hh.twofold"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "twofold",
				"scopeName": "source.twofold",
				"path": "./syntaxes/twofold.tmLanguage.json"
			},
			{
				"language": "twofold-cpp",
				"scopeName": "source.twofold.cpp",
				"path": "./syntaxes/twofold-cpp.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "Twofold",
			"properties": {
				"twofold.targetColumn": {
					"type": "number",
					"default": 32,
					"description": "Target column for output directives (|, \\, =) in twofold files."
				},
				"twofold.clangFormatPath": {
					"type": "string",
					"default": "",
					"description": "Path to clang-format executable. Uses C_Cpp.clang_format_path if not set."
				}
			}
		}
	},
	"icon": "icon.png",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/hicknhack-software/Twofold-Cpp.git"
	}
}