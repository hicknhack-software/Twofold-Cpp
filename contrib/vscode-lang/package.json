{
	"name": "twofold",
	"displayName": "Twofold Language Support",
	"description": "Twofold highlighting, formatting, and source map navigation with generation stacks",
	"version": "0.3.1",
	"publisher": "hicknhack-software",
	"engines": {
		"vscode": "^1.85.0"
	},
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"test": "npm run compile && node --test test/*.test.cjs",
		"test:extension": "npm run compile && node test/runExtensionHost.cjs",
		"watch": "tsc -p ./ -w",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^3.0.0",
		"typescript": "^5.0.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"commands": [
			{
				"command": "twofold.goToGeneratingSource",
				"title": "Twofold: Go to Generating Source"
			},
			{
				"command": "twofold.refreshSourceMap",
				"title": "Twofold: Refresh Source Map",
				"icon": "$(refresh)"
			},
			{
				"command": "twofold.configureSourceMap",
				"title": "Twofold: Configure Source Mapping"
			}
		],
		"viewsContainers": {
			"panel": [
				{
					"id": "twofold-source-maps",
					"title": "Twofold",
					"icon": "media/source-map.svg"
				}
			]
		},
		"views": {
			"twofold-source-maps": [
				{
					"id": "twofold.sources",
					"name": "Sources and Generation Stack"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "twofold.refreshSourceMap",
					"when": "view == twofold.sources",
					"group": "navigation"
				}
			]
		},
		"languages": [
			{
				"id": "twofold",
				"aliases": [
					"Twofold",
					"twofold"
				],
				"extensions": [
					".twofold"
				],
				"filenames": [],
				"configuration": "./language-configuration.json"
			},
			{
				"id": "twofold-cpp",
				"aliases": [
					"Twofold C++",
					"twofold-cpp"
				],
				"extensions": [
					".hpp.twofold",
					".cpp.twofold",
					".h.twofold",
					".c.twofold",
					".hxx.twofold",
					".cxx.twofold",
					".cc.twofold",
					".hh.twofold"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "twofold",
				"scopeName": "source.twofold",
				"path": "./syntaxes/twofold.tmLanguage.json"
			},
			{
				"language": "twofold-cpp",
				"scopeName": "source.twofold.cpp",
				"path": "./syntaxes/twofold-cpp.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "Twofold",
			"properties": {
				"twofold.sourceMap.roots": {
					"type": "object",
					"default": {},
					"additionalProperties": {
						"type": "string"
					},
					"scope": "resource",
					"markdownDescription": "Map source prefixes or full source names to local paths/URIs. Used when configured; otherwise sources are discovered throughout the workspace. Can be set globally or per workspace. File and directory bindings take precedence."
				},
				"twofold.targetColumn": {
					"type": "number",
					"default": 32,
					"description": "Target column for output directives (|, \\, =) in twofold files."
				},
				"twofold.clangFormatPath": {
					"type": "string",
					"default": "",
					"description": "Path to clang-format executable. Uses C_Cpp.clang_format_path if not set."
				},
				"twofold.sourceMap.bindings": {
					"type": "object",
					"default": {},
					"scope": "resource",
					"markdownDescription": "Source roots keyed by generated file or directory URI. Use **Twofold: Configure Source Mapping** or its hover link to create bindings. File bindings override directory bindings; nearest directories override ancestors and general roots.",
					"additionalProperties": {
						"type": "object",
						"required": [
							"scope",
							"roots"
						],
						"additionalProperties": false,
						"properties": {
							"scope": {
								"type": "string",
								"enum": [
									"file",
									"directory"
								]
							},
							"roots": {
								"type": "object",
								"additionalProperties": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		}
	},
	"icon": "icon.png",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/hicknhack-software/Twofold-Cpp.git"
	}
}
