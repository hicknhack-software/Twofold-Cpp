#pragma once
#include "TwofoldRuntime/Twofold.h"
#include "lib.hpp.twofold"

auto structFieldHeader(Type const& type) -> Twofold {
      |#{ type.name }
      |struct #{ type.name } {
      |};
}

auto generate(Data const& data) -> Twofold {
  for (int i = 0; i <= 10000; ++i) {
      | Das ist ein kurzer Text! #{std::to_string(i)}
      = co_await lib_lines();
  }

      |---------------------------------
      |

  if (data.type.isArray) {
      | // #{ data.type.name } Type is an Array #{data.type.text}"
      = co_await structFieldHeader(data.type);
  }

      |class #{ data.name } {
  for (size_t i = 0; i < data.baseNames.size(); ++i) {
      |  #{ (i==0 ? ":" : ",") } public #{ data.baseNames[i] }
  }
      |};
}
